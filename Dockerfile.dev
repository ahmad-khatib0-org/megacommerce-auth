# Multi-stage build for Rust auth service
# Stage 1: Builder (musl for static linking)
FROM rust:alpine AS builder

WORKDIR /app

# Install build dependencies
RUN apk add --no-cache musl-dev pkgconfig openssl-dev build-base postgresql-dev

# Copy dependency files
COPY Cargo.toml Cargo.lock ./

# Create dummy source to cache dependencies
RUN mkdir src && echo "fn main() {}" > src/main.rs

# Download dependencies
RUN cargo fetch --locked

# Copy real source
COPY src ./src
COPY config.dev.yaml ./

# Build with musl target
RUN cargo build --release --target x86_64-unknown-linux-musl && \
    strip target/x86_64-unknown-linux-musl/release/megacommerce-auth

# Stage 2: Tiny runtime image
FROM alpine:latest

WORKDIR /app

# Install ONLY runtime dependencies
RUN apk add --no-cache postgresql-client curl ca-certificates

# Copy stripped binary
COPY --from=builder /app/target/x86_64-unknown-linux-musl/release/megacommerce-auth /usr/local/bin/
COPY --from=builder /app/config.dev.yaml ./

EXPOSE 50054

CMD ["/usr/local/bin/megacommerce-auth"]
